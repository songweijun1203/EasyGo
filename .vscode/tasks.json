{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "type": "shell",
            "command": "go",
            "args": [
                "build",
                "-o", "${workspaceFolder}/build/bin/myapp_debug.exe",
                "-gcflags", "all=-N -l",
                "${workspaceFolder}/cmd/myapp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$go"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path '${workspaceFolder}/build/bin') { Remove-Item -Recurse -Force '${workspaceFolder}/build/bin' }"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}